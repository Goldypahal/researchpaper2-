# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.env

# Protected Private EVADE Dataset Partition
# Keep fresh and private test sets strictly isolated
evade/datasets/processed/private/
evade/datasets/private/

# Raw downloaded benchmark caches (>100MB)
evade/datasets/raw/

# Large local databases and raw temporary caches
evade/results/*.db
evade/results/*.db*
evade/results/*.parquet
evade/results/*.zip
evade/results/evade_pilot_results*
evade/data/*.db*
evade/pilot_results/
evade/notebooks/kaggle_output/
evade/notebooks/log_*/
